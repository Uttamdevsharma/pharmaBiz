enum AccountType {
  CASH
  BANK
  BKASH
  NAGAD
  MOBILE
  CARD_SETTLEMENT
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  SALE_PAYMENT
  PURCHASE_PAYMENT
  REFUND
}

model FinancialAccount {
  id            String      @id @default(uuid())
  tenantId      String
  branchId      String
  name          String
  type          AccountType @default(CASH)
  accountNumber String?
  bankName      String?
  branchName    String?
  routingNumber String?
  isDefault     Boolean     @default(false)
  description   String?
  balance       Decimal     @default(0) @db.Decimal(15, 2)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  transactionsOut FinancialTransaction[] @relation("SourceAccount")
  transactionsIn  FinancialTransaction[] @relation("DestinationAccount")
  sales           Sale[]

  @@index([tenantId])
  @@index([branchId])
  @@index([type])
}

model FinancialTransaction {
  id                   String          @id @default(uuid())
  tenantId             String
  branchId             String
  sourceAccountId      String?
  destinationAccountId String?
  amount               Decimal         @db.Decimal(15, 2)
  type                 TransactionType
  reference            String?
  note                 String?
  userId               String? // Who performed this

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sourceAccount      FinancialAccount? @relation("SourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccount FinancialAccount? @relation("DestinationAccount", fields: [destinationAccountId], references: [id])
  user               User?             @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([branchId])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String?
  userId    String?
  action    String // e.g. "SALE_CREATE", "PRICE_OVERRIDE", "REFUND_APPROVED"
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([branchId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Inventory {
  id                String    @id @default(uuid())
  branchId          String
  productId         String
  supplierId        String?
  quantity          Int       @default(0) // Total quantity in lowest sellable unit (e.g. tablets, ml, units)
  initialQuantity   Int       @default(0)
  batchNumber       String?
  barcode           String?
  mfgDate           DateTime?
  expiryDate        DateTime?
  packageType       String?   @default("PIECE")
  boxQuantity       Int?
  stripsPerBox      Int?
  tabletsPerStrip   Int?
  purchasePrice     Decimal?  @db.Decimal(10, 2)
  sellingPrice      Decimal?  @db.Decimal(10, 2)
  shelfLocation     String?
  minStockLevel     Int       @default(10)
  lowStockThreshold Int       @default(5)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]

  @@index([branchId])
  @@index([productId])
  @@index([supplierId])
  @@index([batchNumber])
  @@index([barcode])
  @@index([expiryDate])
  @@index([quantity])
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

model StockTransfer {
  id              String         @id @default(uuid())
  fromBranchId    String
  toBranchId      String
  status          TransferStatus @default(PENDING)
  requestedBy     String // User ID
  approvedBy      String? // User ID
  receivedBy      String? // User ID
  totalValue      Decimal        @default(0) @db.Decimal(12, 2)
  notes           String?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  fromBranch Branch         @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: Cascade)
  toBranch   Branch         @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: Cascade)
  items      TransferItem[]

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
}

model TransferItem {
  id          String    @id @default(uuid())
  transferId  String
  productId   String
  inventoryId String?
  batchNumber String?
  expiryDate  DateTime?
  quantity    Int // Lowest unit count
  unitPrice   Decimal?  @db.Decimal(10, 2)
  totalAmount Decimal?  @db.Decimal(10, 2)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
}

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  RETURN
}

model StockMovement {
  id                String       @id @default(uuid())
  branchId          String
  productId         String
  inventoryId       String?
  batchNumber       String?
  type              MovementType
  quantity          Int // Positive for additions, negative for reductions
  remainingQuantity Int?
  unitPrice         Decimal?     @db.Decimal(10, 2)
  reason            String?
  performedBy       String? // User ID
  referenceId       String? // Sale ID, Purchase ID, Transfer ID, etc.
  createdAt         DateTime     @default(now())

  inventory Inventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([productId])
  @@index([inventoryId])
  @@index([type])
  @@index([createdAt])
}

enum NotificationType {
  LOW_STOCK
  EXPIRY
  SYNC_FAILURE
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  tenantId  String
  branchId  String?
  userId    String?
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([branchId])
  @@index([userId])
  @@index([isRead])
  @@index([type])
}

enum PaymentStatus {
  PENDING
  VALIDATED
  FAILED
  CANCELLED
}

model Payment {
  id             String        @id @default(uuid())
  tenantId       String
  subscriptionId String?
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("BDT")
  tranId         String        @unique
  valId          String?
  status         PaymentStatus @default(PENDING)
  paymentMethod  String?
  cardType       String?
  cardBrand      String?
  bankTranId     String?
  rawResponse    Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([tranId])
  @@index([status])
}

enum ProductType {
  MEDICINE
  SYRUP
  EQUIPMENT
  SALINE
  OTHER
}

model Category {
  id          String       @id @default(uuid())
  tenantId    String
  name        String
  parentId    String?
  productType ProductType? @default(MEDICINE)
  defaultUnit String? // e.g. "mg", "ml", "pcs", "bottle", "bag", "tablet"
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subcategories Category[] @relation("CategoryHierarchy")
  products      Product[]  @relation("ProductCategory")
  subProducts   Product[]  @relation("ProductSubcategory")

  @@index([tenantId])
  @@index([parentId])
}

model Brand {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Unit {
  id          String       @id @default(uuid())
  tenantId    String
  name        String // e.g. "Milligram", "Milliliter", "Piece", "Tablet", "Strip", "Box"
  symbol      String // e.g. "mg", "ml", "pcs", "tab", "strip", "box"
  productType ProductType? @default(MEDICINE)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Product {
  id              String       @id @default(uuid())
  tenantId        String
  name            String
  genericName     String? // e.g. "Paracetamol", "Cefixime", "Omeprazole"
  sku             String
  barcode         String?
  basePrice       Decimal      @db.Decimal(10, 2)
  category        String? // Main category name e.g. "Medicine"
  categoryId      String? // Main category ID
  subcategory     String? // Subcategory name e.g. "Antibiotics"
  subcategoryId   String? // Subcategory ID
  brandId         String?
  unitId          String?
  productType     ProductType? @default(MEDICINE)
  brandName       String?
  manufacturer    String?
  unit            String       @default("piece")
  imageUrl        String?
  size            String? // e.g. "500mg", "100ml", "1000ml", "Standard"
  defaultPackType String?      @default("PIECE") // e.g. "BOX", "STRIP", "TABLET", "BOTTLE", "PIECE"
  stripsPerBox    Int?         @default(10)
  tabletsPerStrip Int?         @default(10)

  minStockAlert        Int      @default(10)
  description          String?
  isControlled         Boolean  @default(false)
  requiresPrescription Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryRef     Category?       @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryRef  Category?       @relation("ProductSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  brandRef        Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unitRef         Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  inventories     Inventory[]
  saleItems       SaleItem[]
  branchOverrides BranchProduct[]
  purchaseItems   PurchaseItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([genericName])
  @@index([barcode])
  @@index([category])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([brandId])
  @@index([isActive])
}

model BranchProduct {
  id        String   @id @default(uuid())
  branchId  String
  productId String
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  BANK
  CARD
  MOBILE
  OTHER
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  VOIDED
}

model Sale {
  id                 String        @id @default(uuid())
  tenantId           String
  branchId           String
  userId             String
  financialAccountId String?
  customerName       String?
  customerPhone      String?
  customerEmail      String?
  subTotal           Decimal       @default(0) @db.Decimal(12, 2)
  discount           Decimal       @default(0) @db.Decimal(12, 2)
  discountType       String?       @default("FIXED") // "FIXED" | "PERCENT"
  tax                Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  paidAmount         Decimal       @default(0) @db.Decimal(12, 2)
  dueAmount          Decimal       @default(0) @db.Decimal(12, 2)
  changeAmount       Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod      PaymentMethod @default(CASH)
  bankName           String?
  transactionRef     String?
  status             SaleStatus    @default(COMPLETED)
  receiptNo          String        @unique
  invoicePdfUrl      String?
  notes              String?
  managerApprovedBy  String? // Required if controlled or prescription medicine included
  prescriptionRef    String?
  refundReason       String?
  voidReason         String?
  localCreatedAt     DateTime // Captured offline from edge device or online
  syncedAt           DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id])
  financialAccount FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)
  items            SaleItem[]

  @@index([tenantId])
  @@index([branchId])
  @@index([userId])
  @@index([financialAccountId])
  @@index([status])
  @@index([customerPhone])
  @@index([createdAt])
  @@index([localCreatedAt])
}

model SaleItem {
  id                 String    @id @default(uuid())
  saleId             String
  productId          String
  inventoryId        String?
  batchNumber        String?
  expiryDate         DateTime?
  unitType           String?   @default("PIECE") // e.g. "TABLET", "STRIP", "BOX", "BOTTLE", "PIECE"
  unitMultiplier     Int       @default(1) // e.g. 10 tablets per strip, 100 per box
  quantity           Int // Quantity of selected unit
  lowestUnitQuantity Int       @default(1) // Total lowest units deducted (quantity * unitMultiplier)
  unitPrice          Decimal   @db.Decimal(10, 2)
  purchasePrice      Decimal?  @db.Decimal(10, 2)
  subTotal           Decimal   @db.Decimal(10, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
  @@index([inventoryId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "landing_page_content", "theme_config", "general_settings"
  value     Json // Dynamic JSON containing hero, features, contact, primaryColor, etc.
  updatedAt DateTime @updatedAt

  @@index([key])
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

model SubscriptionPlan {
  id           String      @id @default(uuid())
  name         String
  tier         PricingTier @unique
  price        Decimal     @db.Decimal(10, 2)
  billingCycle String      @default("MONTHLY") // MONTHLY, YEARLY
  maxBranches  Int         @default(3)
  features     Json? // Custom feature flags
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id        String             @id @default(uuid())
  tenantId  String
  planId    String
  status    SubscriptionStatus @default(PENDING)
  startDate DateTime           @default(now())
  endDate   DateTime
  autoRenew Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([tenantId])
  @@index([planId])
  @@index([status])
}

enum PurchasePaymentStatus {
  PAID
  PARTIAL
  DUE
}

model Supplier {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  phone          String
  email          String?
  address        String?
  company        String?
  contactPerson  String?
  totalPurchased Decimal  @default(0) @db.Decimal(12, 2)
  totalPaid      Decimal  @default(0) @db.Decimal(12, 2)
  totalDue       Decimal  @default(0) @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases   Purchase[]
  inventories Inventory[]

  @@index([tenantId])
  @@index([name])
  @@index([phone])
}

model Purchase {
  id            String                @id @default(uuid())
  tenantId      String
  branchId      String
  supplierId    String?
  invoiceNo     String?
  purchaseDate  DateTime              @default(now())
  totalAmount   Decimal               @db.Decimal(12, 2)
  paidAmount    Decimal               @default(0) @db.Decimal(12, 2)
  dueAmount     Decimal               @default(0) @db.Decimal(12, 2)
  paymentStatus PurchasePaymentStatus @default(PAID)
  paymentMethod String?               @default("CASH")
  notes         String?
  receivedBy    String // User ID
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items    PurchaseItem[]

  @@index([tenantId])
  @@index([branchId])
  @@index([supplierId])
  @@index([purchaseDate])
}

model PurchaseItem {
  id                String    @id @default(uuid())
  purchaseId        String
  productId         String
  inventoryId       String?
  batchNumber       String?
  barcode           String?
  mfgDate           DateTime?
  expiryDate        DateTime?
  packageType       String? // "MEDICINE", "SYRUP", "EQUIPMENT", "SALINE"
  cartonQuantity    Int?
  boxQuantity       Int?
  stripsPerBox      Int?
  tabletsPerStrip   Int?
  quantity          Int // Lowest sellable unit count
  unitPurchasePrice Decimal   @db.Decimal(10, 2)
  unitSellingPrice  Decimal   @db.Decimal(10, 2)
  totalAmount       Decimal   @db.Decimal(12, 2)
  shelfLocation     String?
  createdAt         DateTime  @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([productId])
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SyncDirection {
  CLOUD_TO_BRANCH
  BRANCH_TO_CLOUD
}

model SyncLog {
  id          String        @id @default(uuid())
  branchId    String
  direction   SyncDirection
  status      SyncStatus    @default(PENDING)
  payloadType String // e.g. "SALE", "INVENTORY", "STOCK_MOVEMENT"
  payload     Json // The offline payload data
  error       String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, status])
  @@index([createdAt])
}

enum PricingTier {
  TRIAL
  STARTER
  GROWTH
  ENTERPRISE
}

model Tenant {
  id           String      @id @default(uuid())
  name         String
  tier         PricingTier @default(TRIAL)
  isActive     Boolean     @default(true)
  email        String?
  phone        String?
  address      String?
  logoUrl      String?
  logoPublicId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  branches              Branch[]
  users                 User[]
  products              Product[]
  categories            Category[]
  brands                Brand[]
  units                 Unit[]
  suppliers             Supplier[]
  purchases             Purchase[]
  subscriptions         Subscription[]
  payments              Payment[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  financialAccounts     FinancialAccount[]
  financialTransactions FinancialTransaction[]
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  location  String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users                 User[]
  inventories           Inventory[]
  purchases             Purchase[]
  sales                 Sale[]
  syncLogs              SyncLog[]
  branchProducts        BranchProduct[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  financialAccounts     FinancialAccount[]
  financialTransactions FinancialTransaction[]

  stockTransfersFrom StockTransfer[] @relation("TransferFrom")
  stockTransfersTo   StockTransfer[] @relation("TransferTo")

  @@index([tenantId])
  @@index([isActive])
}

enum RoleName {
  SUPER_ADMIN
  COMPANY_OWNER
  REGIONAL_ADMIN
  BRANCH_MANAGER
  MANAGER
  INVENTORY_EXECUTIVE
  CASHIER
  ACCOUNTS
  AUDITOR
  CTO
  PROJECT_MANAGER
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  branchId     String?
  role         RoleName
  username     String   @unique
  passwordHash String
  name         String?
  email        String?
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sales                 Sale[]
  financialTransactions FinancialTransaction[]

  @@index([tenantId])
  @@index([branchId])
  @@index([role])
  @@index([isActive])
}

model RolePermission {
  id         String   @id @default(uuid())
  role       RoleName
  permission String // e.g., "sales:refund", "inventory:transfer"
  createdAt  DateTime @default(now())

  @@unique([role, permission])
}
