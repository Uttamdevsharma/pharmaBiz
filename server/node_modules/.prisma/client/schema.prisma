enum AccountType {
  CASH
  BANK
  BKASH
  NAGAD
  MOBILE
  CARD_SETTLEMENT
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  SALE_PAYMENT
  PURCHASE_PAYMENT
  REFUND
}

enum ExpenseCategory {
  SHOP_RENT
  ELECTRICITY_BILL
  INTERNET_BILL
  SECURITY_GUARD
  MAINTENANCE
  EMPLOYEE_SALARY
  OTHER
}

enum SalaryStatus {
  PAID
  PARTIAL
  DUE
}

model FinancialAccount {
  id            String      @id @default(uuid())
  tenantId      String
  branchId      String
  name          String
  type          AccountType @default(CASH)
  accountNumber String?
  bankName      String?
  branchName    String?
  routingNumber String?
  isDefault     Boolean     @default(false)
  description   String?
  balance       Decimal     @default(0) @db.Decimal(15, 2)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  transactionsOut     FinancialTransaction[] @relation("SourceAccount")
  transactionsIn      FinancialTransaction[] @relation("DestinationAccount")
  sales               Sale[]
  settlementsOut      TransferSettlement[]   @relation("SettlementSourceAccount")
  settlementsIn       TransferSettlement[]   @relation("SettlementDestAccount")
  expenses            BranchExpense[]
  salaryDisbursements SalaryDisbursement[]
  supplierPayments    SupplierPayment[]

  @@index([tenantId])
  @@index([branchId])
  @@index([type])
}

model FinancialTransaction {
  id                   String          @id @default(uuid())
  tenantId             String
  branchId             String
  sourceAccountId      String?
  destinationAccountId String?
  amount               Decimal         @db.Decimal(15, 2)
  type                 TransactionType
  reference            String?
  note                 String?
  userId               String? // Who performed this

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sourceAccount      FinancialAccount? @relation("SourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccount FinancialAccount? @relation("DestinationAccount", fields: [destinationAccountId], references: [id])
  user               User?             @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([branchId])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@index([createdAt])
}

model RecurringExpenseConfig {
  id              String          @id @default(uuid())
  tenantId        String
  branchId        String
  category        ExpenseCategory @default(OTHER)
  title           String
  estimatedAmount Decimal         @db.Decimal(15, 2)
  dueDay          Int? // e.g. 5th of month
  notes           String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  expenses BranchExpense[]

  @@index([tenantId])
  @@index([branchId])
  @@index([category])
}

model BranchExpense {
  id                 String          @id @default(uuid())
  tenantId           String
  branchId           String
  financialAccountId String
  recurringConfigId  String?
  category           ExpenseCategory @default(OTHER)
  title              String
  expenseMonth       String // e.g. "2026-09"
  amount             Decimal         @db.Decimal(15, 2)
  paymentDate        DateTime        @default(now())
  voucherNo          String?
  reference          String?
  notes              String?
  recordedById       String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount        @relation(fields: [financialAccountId], references: [id])
  recurringConfig  RecurringExpenseConfig? @relation(fields: [recurringConfigId], references: [id], onDelete: SetNull)
  recordedBy       User?                   @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([branchId])
  @@index([financialAccountId])
  @@index([expenseMonth])
  @@index([category])
}

model EmployeeSalaryConfig {
  id             String    @id @default(uuid())
  tenantId       String
  branchId       String
  userId         String    @unique
  baseSalary     Decimal   @default(0) @db.Decimal(15, 2)
  allowances     Decimal   @default(0) @db.Decimal(15, 2)
  deductions     Decimal   @default(0) @db.Decimal(15, 2)
  netSalary      Decimal   @default(0) @db.Decimal(15, 2)
  paymentMethod  String? // "CASH", "BANK", "BKASH", "NAGAD"
  paymentDetails String? // Account number, bKash wallet number, etc.
  effectiveDate  DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([branchId])
}

model SalaryDisbursement {
  id                  String       @id @default(uuid())
  tenantId            String
  branchId            String
  userId              String // Employee receiving salary
  financialAccountId  String // Paid from branch financial account
  month               String // e.g. "2026-09"
  baseAmount          Decimal      @default(0) @db.Decimal(15, 2)
  allowances          Decimal      @default(0) @db.Decimal(15, 2)
  deductions          Decimal      @default(0) @db.Decimal(15, 2)
  netPayable          Decimal      @default(0) @db.Decimal(15, 2)
  paidAmount          Decimal      @default(0) @db.Decimal(15, 2)
  dueAmount           Decimal      @default(0) @db.Decimal(15, 2)
  status              SalaryStatus @default(PAID)
  totalDays           Int?
  offDays             Int?
  workingDays         Int?
  presentDays         Int?
  absentDays          Int?
  paidLeaveDays       Int?
  unpaidLeaveDays     Int?
  dailyRate           Decimal?     @db.Decimal(15, 2)
  attendanceDeduction Decimal?     @db.Decimal(15, 2)
  allowanceBreakdown  Json?
  paymentDate         DateTime     @default(now())
  paymentRef          String? // Txn or voucher reference
  notes               String?
  disbursedById       String? // Manager who recorded disbursement
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user             User             @relation("EmployeeSalaryDisbursements", fields: [userId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id])
  disbursedBy      User?            @relation("DisbursedBySalaries", fields: [disbursedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([branchId])
  @@index([userId])
  @@index([month])
  @@index([financialAccountId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  PAID_LEAVE
  UNPAID_LEAVE
  OFF_DAY
}

model BranchOffDayConfig {
  id             String   @id @default(uuid())
  tenantId       String
  branchId       String
  month          String // "YYYY-MM", e.g. "2026-09"
  weeklyOffDays  String[] @default(["FRIDAY"]) // ["FRIDAY", "SATURDAY", etc.]
  customOffDates String[] @default([]) // ["2026-09-15"]
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, month])
  @@index([tenantId])
  @@index([branchId])
  @@index([month])
}

model EmployeeAttendance {
  id         String           @id @default(uuid())
  tenantId   String
  branchId   String
  userId     String // Employee receiving attendance
  date       String // "YYYY-MM-DD"
  status     AttendanceStatus
  notes      String?
  markedById String? // Manager who marked
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user     User   @relation("EmployeeAttendances", fields: [userId], references: [id], onDelete: Cascade)
  markedBy User?  @relation("MarkedAttendances", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@index([tenantId])
  @@index([branchId])
  @@index([userId])
  @@index([date])
}

model EmployeeMonthlyAllowance {
  id          String   @id @default(uuid())
  tenantId    String
  branchId    String
  userId      String
  month       String // "YYYY-MM"
  title       String // e.g. "Performance Bonus", "Transport Allowance", "Food Allowance", "Overtime"
  amount      Decimal  @default(0) @db.Decimal(15, 2)
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([branchId])
  @@index([userId])
  @@index([month])
}

model SalaryDeductionRule {
  id              String   @id @default(uuid())
  tenantId        String
  branchId        String
  absentRuleRatio Decimal? @db.Decimal(5, 2)
  lateRuleRatio   Decimal? @db.Decimal(5, 2)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId])
  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String?
  userId    String?
  action    String // e.g. "SALE_CREATE", "PRICE_OVERRIDE", "REFUND_APPROVED"
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([branchId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Inventory {
  id                       String    @id @default(uuid())
  branchId                 String
  productId                String
  supplierId               String?
  quantity                 Int       @default(0) // Total quantity in lowest sellable unit (e.g. tablets, ml, units)
  initialQuantity          Int       @default(0)
  batchNumber              String?
  barcode                  String?
  mfgDate                  DateTime?
  expiryDate               DateTime?
  packageType              String?   @default("PIECE")
  cartonQuantity           Int?
  boxesPerCarton           Int?
  boxQuantity              Int?
  stripsPerBox             Int?
  tabletsPerStrip          Int?
  cartonsReceived          Int?      @default(0)
  looseBoxesReceived       Int?      @default(0)
  allocatedCartons         Int?      @default(0)
  allocatedLooseBoxes      Int?      @default(0)
  boxesAllocatedFromCarton Int?      @default(0)
  purchasePrice            Decimal?  @db.Decimal(10, 2)
  sellingPrice             Decimal?  @db.Decimal(10, 2)
  boxPurchasePrice         Decimal?  @db.Decimal(10, 2)
  boxSellingPrice          Decimal?  @db.Decimal(10, 2)
  shelfLocation            String?
  minStockLevel            Int       @default(10)
  lowStockThreshold        Int       @default(5)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  receivedDate             DateTime? @default(now())

  branch           Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product          Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier         Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stockMovements   StockMovement[]
  locations        InventoryLocation[]
  receivingRecords BatchReceivingRecord[]

  @@index([branchId])
  @@index([productId])
  @@index([supplierId])
  @@index([batchNumber])
  @@index([barcode])
  @@index([expiryDate])
  @@index([quantity])
  @@index([receivedDate])
}

model InventoryLocation {
  id          String   @id @default(uuid())
  inventoryId String
  rackId      String?
  shelfId     String?
  binId       String?
  quantity    Int      @default(0) // Quantity in lowest unit at this location
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  rack      Rack?     @relation(fields: [rackId], references: [id], onDelete: SetNull)
  shelf     Shelf?    @relation(fields: [shelfId], references: [id], onDelete: SetNull)
  bin       Bin?      @relation(fields: [binId], references: [id], onDelete: SetNull)

  movementsFrom StockMovement[] @relation("MovementFromLocation")
  movementsTo   StockMovement[] @relation("MovementToLocation")
  saleItems     SaleItem[]

  @@index([inventoryId])
  @@index([rackId, shelfId, binId])
}

model Rack {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shelves            Shelf[]
  inventoryLocations InventoryLocation[]

  @@index([branchId])
}

model Shelf {
  id        String   @id @default(uuid())
  rackId    String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rack               Rack                @relation(fields: [rackId], references: [id], onDelete: Cascade)
  bins               Bin[]
  inventoryLocations InventoryLocation[]

  @@index([rackId])
}

model Bin {
  id        String   @id @default(uuid())
  shelfId   String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shelf              Shelf               @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  inventoryLocations InventoryLocation[]

  @@index([shelfId])
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum SettlementStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model StockTransfer {
  id           String         @id @default(uuid())
  fromBranchId String
  toBranchId   String
  status       TransferStatus @default(IN_TRANSIT)
  requestedBy  String // User ID who created/dispatched
  approvedBy   String? // User ID
  receivedBy   String? // User ID who received

  // Legacy / total value
  totalValue Decimal? @default(0) @db.Decimal(12, 2)

  // Financial valuations based strictly on purchase/cost price
  sentTotalValue     Decimal          @default(0) @db.Decimal(12, 2)
  receivedTotalValue Decimal          @default(0) @db.Decimal(12, 2)
  damagedTotalValue  Decimal          @default(0) @db.Decimal(12, 2)
  missingTotalValue  Decimal          @default(0) @db.Decimal(12, 2)
  payableAmount      Decimal          @default(0) @db.Decimal(12, 2) // equals receivedTotalValue
  paidAmount         Decimal          @default(0) @db.Decimal(12, 2)
  remainingDue       Decimal          @default(0) @db.Decimal(12, 2)
  settlementStatus   SettlementStatus @default(UNPAID)

  notes           String?
  rejectionReason String?
  transferDate    DateTime  @default(now())
  receivedDate    DateTime?
  settlementDate  DateTime?

  // Professional Courier Logistics & Dispatch Information
  courierName           String? // e.g. Steadfast, Pathao, RedX, Sundarban, Internal Rider
  courierHub            String? // Hub / Branch of courier service
  trackingId            String? // Waybill / Consignment / Tracking ID
  deliveryPersonName    String? // Rider / Delivery Person Name
  deliveryPersonContact String? // Rider Phone / Contact Number
  dispatchDate          DateTime? // Dispatch Date & Time
  deliveryNote          String? // Special delivery or handling instructions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromBranch  Branch               @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: Cascade)
  toBranch    Branch               @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: Cascade)
  items       TransferItem[]
  settlements TransferSettlement[]

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@index([settlementStatus])
  @@index([transferDate])
}

model TransferItem {
  id          String    @id @default(uuid())
  transferId  String
  productId   String
  inventoryId String?
  batchNumber String?
  expiryDate  DateTime?

  packageType      String? @default("PIECE") // e.g. BOX, STRIP, TABLET, BOTTLE, PIECE
  packageQuantity  Int? // Count in package unit (e.g. 10 boxes)
  conversionFactor Int?    @default(1) // e.g. 100 tablets per box

  // Legacy quantity field kept for compatibility
  quantity    Int?     @default(0)
  unitPrice   Decimal? @db.Decimal(10, 2)
  totalAmount Decimal? @db.Decimal(10, 2)

  sentQuantity     Int @default(0) // Total sent in lowest units
  receivedQuantity Int @default(0) // Total successfully received in lowest units
  damagedQuantity  Int @default(0) // Total damaged in transit
  missingQuantity  Int @default(0) // Total missing in transit

  costPrice     Decimal @default(0) @db.Decimal(10, 2) // Actual purchase/cost price per lowest unit
  sentValue     Decimal @default(0) @db.Decimal(10, 2) // sentQuantity * costPrice
  receivedValue Decimal @default(0) @db.Decimal(10, 2) // receivedQuantity * costPrice
  damagedValue  Decimal @default(0) @db.Decimal(10, 2) // damagedQuantity * costPrice
  missingValue  Decimal @default(0) @db.Decimal(10, 2) // missingQuantity * costPrice

  itemStatus String  @default("PENDING") // PENDING, RECEIVED, PARTIALLY_RECEIVED, DAMAGED, MISSING
  notes      String?

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([productId])
  @@index([batchNumber])
}

model TransferSettlement {
  id                   String   @id @default(uuid())
  transferId           String
  tenantId             String
  fromBranchId         String // Source branch (receiving funds)
  toBranchId           String // Destination branch (paying funds)
  sourceAccountId      String? // Paying account
  destinationAccountId String? // Receiving account
  amount               Decimal  @db.Decimal(12, 2)
  paymentMethod        String   @default("CASH") // CASH, BANK, BKASH, NAGAD, etc.
  reference            String?
  notes                String?
  paidBy               String? // User ID
  createdAt            DateTime @default(now())

  transfer           StockTransfer     @relation(fields: [transferId], references: [id], onDelete: Cascade)
  fromBranch         Branch            @relation("SettlementFromBranch", fields: [fromBranchId], references: [id], onDelete: Cascade)
  toBranch           Branch            @relation("SettlementToBranch", fields: [toBranchId], references: [id], onDelete: Cascade)
  sourceAccount      FinancialAccount? @relation("SettlementSourceAccount", fields: [sourceAccountId], references: [id], onDelete: SetNull)
  destinationAccount FinancialAccount? @relation("SettlementDestAccount", fields: [destinationAccountId], references: [id], onDelete: SetNull)

  @@index([transferId])
  @@index([tenantId])
  @@index([fromBranchId])
  @@index([toBranchId])
}

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  RETURN
  ALLOCATION
  LOCATION_TRANSFER
}

model StockMovement {
  id                String       @id @default(uuid())
  branchId          String
  productId         String
  inventoryId       String?
  batchNumber       String?
  type              MovementType
  quantity          Int // Positive for additions, negative for reductions
  remainingQuantity Int?
  unitPrice         Decimal?     @db.Decimal(10, 2)
  reason            String?
  performedBy       String? // User ID
  referenceId       String? // Sale ID, Purchase ID, Transfer ID, etc.
  fromLocationId    String? // InventoryLocation ID
  toLocationId      String? // InventoryLocation ID
  createdAt         DateTime     @default(now())

  inventory    Inventory?         @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  fromLocation InventoryLocation? @relation("MovementFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   InventoryLocation? @relation("MovementToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([productId])
  @@index([inventoryId])
  @@index([type])
  @@index([createdAt])
}

model BatchReceivingRecord {
  id               String    @id @default(uuid())
  inventoryId      String
  branchId         String
  productId        String
  supplierId       String?
  batchNumber      String?
  receivingUnit    String    @default("CARTON") // "CARTON" | "BOX"
  cartonsReceived  Int?      @default(0)
  boxesPerCarton   Int?      @default(10)
  boxesReceived    Int       @default(0)
  stripsPerBox     Int?      @default(10)
  tabletsPerStrip  Int?      @default(10)
  totalQuantity    Int       @default(0) // Lowest sellable unit count (tablets, etc.)
  purchasePrice    Decimal?  @db.Decimal(10, 2)
  sellingPrice     Decimal?  @db.Decimal(10, 2)
  boxPurchasePrice Decimal?  @db.Decimal(10, 2)
  boxSellingPrice  Decimal?  @db.Decimal(10, 2)
  receivedDate     DateTime  @default(now())
  expiryDate       DateTime?
  mfgDate          DateTime?
  invoiceNo        String?
  notes            String?
  receivedBy       String? // User ID
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  inventory         Inventory        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  supplier          Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  contactPersonId   String?
  contactPersonName String?
  contactPerson     SupplierContact? @relation(fields: [contactPersonId], references: [id], onDelete: SetNull)

  @@index([inventoryId])
  @@index([branchId])
  @@index([productId])
  @@index([supplierId])
  @@index([contactPersonId])
  @@index([batchNumber])
  @@index([receivedDate])
}

enum NotificationType {
  LOW_STOCK
  EXPIRY
  SYNC_FAILURE
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  tenantId  String
  branchId  String?
  userId    String?
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([branchId])
  @@index([userId])
  @@index([isRead])
  @@index([type])
}

enum PaymentStatus {
  PENDING
  VALIDATED
  FAILED
  CANCELLED
}

model Payment {
  id             String        @id @default(uuid())
  tenantId       String
  subscriptionId String?
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("BDT")
  tranId         String        @unique
  valId          String?
  status         PaymentStatus @default(PENDING)
  paymentMethod  String?
  cardType       String?
  cardBrand      String?
  bankTranId     String?
  rawResponse    Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([tranId])
  @@index([status])
}

enum ProductType {
  MEDICINE
  SYRUP
  EQUIPMENT
  SALINE
  OTHER
}

model Category {
  id          String       @id @default(uuid())
  tenantId    String
  name        String
  parentId    String?
  productType ProductType? @default(MEDICINE)
  defaultUnit String? // e.g. "mg", "ml", "pcs", "bottle", "bag", "tablet"
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subcategories Category[] @relation("CategoryHierarchy")
  products      Product[]  @relation("ProductCategory")
  subProducts   Product[]  @relation("ProductSubcategory")

  @@index([tenantId])
  @@index([parentId])
}

model Brand {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Unit {
  id          String       @id @default(uuid())
  tenantId    String
  name        String // e.g. "Milligram", "Milliliter", "Piece", "Tablet", "Strip", "Box"
  symbol      String // e.g. "mg", "ml", "pcs", "tab", "strip", "box"
  productType ProductType? @default(MEDICINE)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Product {
  id              String       @id @default(uuid())
  tenantId        String
  name            String
  genericName     String? // e.g. "Paracetamol", "Cefixime", "Omeprazole"
  sku             String
  barcode         String?
  basePrice       Decimal      @db.Decimal(10, 2)
  category        String? // Main category name e.g. "Medicine"
  categoryId      String? // Main category ID
  subcategory     String? // Subcategory name e.g. "Antibiotics"
  subcategoryId   String? // Subcategory ID
  brandId         String?
  unitId          String?
  productType     ProductType? @default(MEDICINE)
  brandName       String?
  manufacturer    String?
  unit            String       @default("piece")
  imageUrl        String?
  size            String? // e.g. "500mg", "100ml", "1000ml", "Standard"
  defaultPackType String?      @default("PIECE") // e.g. "BOX", "STRIP", "TABLET", "BOTTLE", "PIECE"

  // Hierarchical Packaging Fields
  packLevel1   String? // e.g. "Carton"
  packLevel2   String? // e.g. "Box"
  packLevel3   String? // e.g. "Strip"
  packLevel4   String? // e.g. "Tablet"
  qtyPerLevel2 Int? // e.g. 10 (1 Carton = 10 Boxes)
  qtyPerLevel3 Int? // e.g. 10 (1 Box = 10 Strips)
  qtyPerLevel4 Int? // e.g. 10 (1 Strip = 10 Tablets)

  // Legacy fields (kept for backward compatibility)
  stripsPerBox    Int? @default(10)
  tabletsPerStrip Int? @default(10)

  minStockAlert        Int      @default(10)
  description          String?
  isControlled         Boolean  @default(false)
  requiresPrescription Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryRef     Category?       @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryRef  Category?       @relation("ProductSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  brandRef        Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unitRef         Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  inventories     Inventory[]
  saleItems       SaleItem[]
  branchOverrides BranchProduct[]
  purchaseItems   PurchaseItem[]
  transferItems   TransferItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([genericName])
  @@index([barcode])
  @@index([category])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([brandId])
  @@index([isActive])
}

model BranchProduct {
  id        String   @id @default(uuid())
  branchId  String
  productId String
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  BANK
  CARD
  MOBILE
  OTHER
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  VOIDED
}

model Sale {
  id                 String        @id @default(uuid())
  tenantId           String
  branchId           String
  userId             String
  financialAccountId String?
  customerName       String?
  customerPhone      String?
  customerEmail      String?
  subTotal           Decimal       @default(0) @db.Decimal(12, 2)
  discount           Decimal       @default(0) @db.Decimal(12, 2)
  discountType       String?       @default("FIXED") // "FIXED" | "PERCENT"
  tax                Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  paidAmount         Decimal       @default(0) @db.Decimal(12, 2)
  dueAmount          Decimal       @default(0) @db.Decimal(12, 2)
  changeAmount       Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod      PaymentMethod @default(CASH)
  bankName           String?
  transactionRef     String?
  status             SaleStatus    @default(COMPLETED)
  receiptNo          String        @unique
  invoicePdfUrl      String?
  notes              String?
  managerApprovedBy  String? // Required if controlled or prescription medicine included
  prescriptionRef    String?
  refundReason       String?
  voidReason         String?
  localCreatedAt     DateTime // Captured offline from edge device or online
  syncedAt           DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id])
  financialAccount FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)
  items            SaleItem[]

  @@index([tenantId])
  @@index([branchId])
  @@index([userId])
  @@index([financialAccountId])
  @@index([status])
  @@index([customerPhone])
  @@index([createdAt])
  @@index([localCreatedAt])
}

model SaleItem {
  id                  String    @id @default(uuid())
  saleId              String
  productId           String
  inventoryId         String?
  inventoryLocationId String?
  batchNumber         String?
  expiryDate          DateTime?
  unitType            String?   @default("PIECE") // e.g. "TABLET", "STRIP", "BOX", "BOTTLE", "PIECE"
  unitMultiplier      Int       @default(1) // e.g. 10 tablets per strip, 100 per box
  quantity            Int // Quantity of selected unit
  lowestUnitQuantity  Int       @default(1) // Total lowest units deducted (quantity * unitMultiplier)
  unitPrice           Decimal   @db.Decimal(10, 2)
  purchasePrice       Decimal?  @db.Decimal(10, 2)
  subTotal            Decimal   @db.Decimal(10, 2)

  sale              Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryLocation InventoryLocation? @relation(fields: [inventoryLocationId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
  @@index([inventoryId])
  @@index([inventoryLocationId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "landing_page_content", "theme_config", "general_settings"
  value     Json // Dynamic JSON containing hero, features, contact, primaryColor, etc.
  updatedAt DateTime @updatedAt

  @@index([key])
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

model SubscriptionPlan {
  id           String      @id @default(uuid())
  name         String
  tier         PricingTier @unique
  price        Decimal     @db.Decimal(10, 2)
  billingCycle String      @default("MONTHLY") // MONTHLY, YEARLY
  maxBranches  Int         @default(3)
  features     Json? // Custom feature flags
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(uuid())
  tenantId             String
  planId               String
  status               SubscriptionStatus @default(PENDING)
  startDate            DateTime           @default(now())
  endDate              DateTime
  autoRenew            Boolean            @default(false)
  expiryReminderSentAt DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([tenantId])
  @@index([planId])
  @@index([status])
}

enum PurchasePaymentStatus {
  PAID
  PARTIAL
  DUE
}

model Supplier {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  phone          String
  email          String?
  address        String?
  company        String?
  contactPerson  String?
  totalPurchased Decimal  @default(0) @db.Decimal(12, 2)
  totalPaid      Decimal  @default(0) @db.Decimal(12, 2)
  totalDue       Decimal  @default(0) @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases        Purchase[]
  inventories      Inventory[]
  receivingRecords BatchReceivingRecord[]
  contacts         SupplierContact[]
  payments         SupplierPayment[]

  @@index([tenantId])
  @@index([name])
  @@index([phone])
}

model Purchase {
  id                String                @id @default(uuid())
  tenantId          String
  branchId          String
  supplierId        String?
  contactPersonId   String?
  contactPersonName String?
  invoiceNo         String?
  purchaseDate      DateTime              @default(now())
  totalAmount       Decimal               @db.Decimal(12, 2)
  paidAmount        Decimal               @default(0) @db.Decimal(12, 2)
  dueAmount         Decimal               @default(0) @db.Decimal(12, 2)
  paymentStatus     PurchasePaymentStatus @default(PAID)
  paymentMethod     String?               @default("CASH")
  notes             String?
  receivedBy        String // User ID
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier      Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  contactPerson SupplierContact?  @relation(fields: [contactPersonId], references: [id], onDelete: SetNull)
  items         PurchaseItem[]
  payments      SupplierPayment[]

  @@index([tenantId])
  @@index([branchId])
  @@index([supplierId])
  @@index([contactPersonId])
  @@index([purchaseDate])
}

model PurchaseItem {
  id                String    @id @default(uuid())
  purchaseId        String
  productId         String
  inventoryId       String?
  batchNumber       String?
  barcode           String?
  mfgDate           DateTime?
  expiryDate        DateTime?
  packageType       String? // "MEDICINE", "SYRUP", "EQUIPMENT", "SALINE"
  cartonQuantity    Int?
  boxQuantity       Int?
  stripsPerBox      Int?
  tabletsPerStrip   Int?
  quantity          Int // Lowest sellable unit count
  unitPurchasePrice Decimal   @db.Decimal(10, 2)
  unitSellingPrice  Decimal   @db.Decimal(10, 2)
  totalAmount       Decimal   @db.Decimal(12, 2)
  shelfLocation     String?
  createdAt         DateTime  @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([productId])
}

model SupplierContact {
  id          String   @id @default(uuid())
  tenantId    String
  supplierId  String
  name        String
  phone       String
  email       String?
  designation String? // e.g. "Sales Representative (SR)", "Area Manager", "Delivery Executive"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier         Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchases        Purchase[]
  receivingRecords BatchReceivingRecord[]

  @@index([tenantId])
  @@index([supplierId])
  @@index([phone])
}

model SupplierPayment {
  id                 String   @id @default(uuid())
  tenantId           String
  supplierId         String
  branchId           String?
  purchaseId         String?
  financialAccountId String?
  amount             Decimal  @db.Decimal(12, 2)
  previousDue        Decimal  @default(0) @db.Decimal(12, 2)
  remainingDue       Decimal  @default(0) @db.Decimal(12, 2)
  paymentMethod      String?  @default("CASH")
  reference          String?
  notes              String?
  paidBy             String? // User ID
  paymentDate        DateTime @default(now())
  createdAt          DateTime @default(now())

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier         Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  purchase         Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  financialAccount FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([supplierId])
  @@index([branchId])
  @@index([paymentDate])
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SyncDirection {
  CLOUD_TO_BRANCH
  BRANCH_TO_CLOUD
}

model SyncLog {
  id          String        @id @default(uuid())
  branchId    String
  direction   SyncDirection
  status      SyncStatus    @default(PENDING)
  payloadType String // e.g. "SALE", "INVENTORY", "STOCK_MOVEMENT"
  payload     Json // The offline payload data
  error       String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, status])
  @@index([createdAt])
}

enum PricingTier {
  TRIAL
  STARTER
  GROWTH
  ENTERPRISE
}

enum VerificationStatus {
  PENDING_OTP
  PENDING_APPROVAL
  APPROVED_PENDING_PAYMENT
  ACTIVE
  REJECTED
}

model Tenant {
  id           String      @id @default(uuid())
  name         String
  tier         PricingTier @default(TRIAL)
  isActive     Boolean     @default(true)
  email        String?
  phone        String?
  address      String?
  logoUrl      String?
  logoPublicId String?

  // Regulatory Verification & Compliance (Separate Front & Back sides)
  verificationStatus VerificationStatus @default(PENDING_OTP)
  nidNumber          String?
  nidDocUrl          String?
  nidDocPublicId     String?
  nidFrontUrl        String?
  nidFrontPublicId   String?
  nidBackUrl         String?
  nidBackPublicId    String?

  tradeLicenseNumber        String?
  tradeLicenseDocUrl        String?
  tradeLicenseDocPublicId   String?
  tradeLicenseFrontUrl      String?
  tradeLicenseFrontPublicId String?
  tradeLicenseBackUrl       String?
  tradeLicenseBackPublicId  String?

  drugLicenseNumber        String?
  drugLicenseDocUrl        String?
  drugLicenseDocPublicId   String?
  drugLicenseFrontUrl      String?
  drugLicenseFrontPublicId String?
  drugLicenseBackUrl       String?
  drugLicenseBackPublicId  String?

  // Email OTP Verification
  otpCode       String?
  otpExpiresAt  DateTime?
  otpVerifiedAt DateTime?

  // Super Admin Review & Approval History
  approvedAt      DateTime?
  approvedBy      String?
  approvalNotes   String?
  rejectedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?

  // Selected Plan Before Approval
  pendingPlanId       String?
  pendingBillingCycle String? @default("MONTHLY")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches                  Branch[]
  users                     User[]
  products                  Product[]
  categories                Category[]
  brands                    Brand[]
  units                     Unit[]
  suppliers                 Supplier[]
  purchases                 Purchase[]
  subscriptions             Subscription[]
  payments                  Payment[]
  auditLogs                 AuditLog[]
  notifications             Notification[]
  financialAccounts         FinancialAccount[]
  financialTransactions     FinancialTransaction[]
  pharmacyRoles             PharmacyRole[]
  branchExpenses            BranchExpense[]
  recurringExpenseConfigs   RecurringExpenseConfig[]
  employeeSalaryConfigs     EmployeeSalaryConfig[]
  salaryDisbursements       SalaryDisbursement[]
  branchOffDayConfigs       BranchOffDayConfig[]
  employeeAttendances       EmployeeAttendance[]
  employeeMonthlyAllowances EmployeeMonthlyAllowance[]
  salaryDeductionRules      SalaryDeductionRule[]
  supplierContacts          SupplierContact[]
  supplierPayments          SupplierPayment[]

  @@index([verificationStatus])
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  location  String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users                     User[]
  inventories               Inventory[]
  purchases                 Purchase[]
  sales                     Sale[]
  syncLogs                  SyncLog[]
  branchProducts            BranchProduct[]
  auditLogs                 AuditLog[]
  notifications             Notification[]
  financialAccounts         FinancialAccount[]
  supplierPayments          SupplierPayment[]
  financialTransactions     FinancialTransaction[]
  branchExpenses            BranchExpense[]
  recurringExpenseConfigs   RecurringExpenseConfig[]
  employeeSalaryConfigs     EmployeeSalaryConfig[]
  salaryDisbursements       SalaryDisbursement[]
  branchOffDayConfigs       BranchOffDayConfig[]
  employeeAttendances       EmployeeAttendance[]
  employeeMonthlyAllowances EmployeeMonthlyAllowance[]
  salaryDeductionRules      SalaryDeductionRule[]

  stockTransfersFrom StockTransfer[]      @relation("TransferFrom")
  stockTransfersTo   StockTransfer[]      @relation("TransferTo")
  settlementsFrom    TransferSettlement[] @relation("SettlementFromBranch")
  settlementsTo      TransferSettlement[] @relation("SettlementToBranch")

  @@index([tenantId])
  @@index([isActive])
}

enum RoleName {
  SUPER_ADMIN
  COMPANY_OWNER
  REGIONAL_ADMIN
  BRANCH_MANAGER
  MANAGER
  INVENTORY_EXECUTIVE
  CASHIER
  ACCOUNTS
  AUDITOR
  CTO
  PROJECT_MANAGER
}

model User {
  id                String    @id @default(uuid())
  tenantId          String
  branchId          String?
  role              RoleName
  customRoleId      String?
  customRoleName    String?
  pharmacyRoleId    String?
  pharmacyRoleName  String?
  permissions       String[]  @default([])
  username          String    @unique
  passwordHash      String
  name              String?
  email             String?
  phone             String?
  avatarUrl         String?
  isActive          Boolean   @default(true)
  resignationDate   DateTime?
  resignationReason String?
  deactivatedAt     DateTime?
  deactivatedById   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant                Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                Branch?                    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customRole            PlatformRole?              @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  pharmacyRole          PharmacyRole?              @relation(fields: [pharmacyRoleId], references: [id], onDelete: SetNull)
  sales                 Sale[]
  financialTransactions FinancialTransaction[]
  salaryConfig          EmployeeSalaryConfig?
  salaryDisbursements   SalaryDisbursement[]       @relation("EmployeeSalaryDisbursements")
  disbursedSalaries     SalaryDisbursement[]       @relation("DisbursedBySalaries")
  branchExpenses        BranchExpense[]
  attendances           EmployeeAttendance[]       @relation("EmployeeAttendances")
  markedAttendances     EmployeeAttendance[]       @relation("MarkedAttendances")
  monthlyAllowances     EmployeeMonthlyAllowance[]

  @@index([tenantId])
  @@index([branchId])
  @@index([role])
  @@index([customRoleId])
  @@index([pharmacyRoleId])
  @@index([isActive])
}

model PlatformRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@index([name])
}

model PharmacyRole {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([name])
}

model RolePermission {
  id         String   @id @default(uuid())
  role       RoleName
  permission String // e.g., "sales:refund", "inventory:transfer"
  createdAt  DateTime @default(now())

  @@unique([role, permission])
}
