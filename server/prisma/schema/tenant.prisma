enum PricingTier {
  TRIAL
  STARTER
  GROWTH
  ENTERPRISE
}

model Tenant {
  id            String          @id @default(uuid())
  name          String
  tier          PricingTier     @default(TRIAL)
  isActive      Boolean         @default(true)
  email         String?
  phone         String?
  address       String?
  logoUrl       String?
  logoPublicId  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  branches      Branch[]
  users         User[]
  products      Product[]
  categories    Category[]
  brands        Brand[]
  units         Unit[]
  suppliers     Supplier[]
  purchases     Purchase[]
  subscriptions Subscription[]
  payments      Payment[]
  auditLogs     AuditLog[]
  notifications Notification[]
}

model Branch {
  id             String          @id @default(uuid())
  tenantId       String
  name           String
  location       String?
  phone          String?
  email          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users          User[]
  inventories    Inventory[]
  purchases      Purchase[]
  sales          Sale[]
  syncLogs       SyncLog[]
  branchProducts BranchProduct[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  
  stockTransfersFrom StockTransfer[] @relation("TransferFrom")
  stockTransfersTo   StockTransfer[] @relation("TransferTo")

  @@index([tenantId])
  @@index([isActive])
}
