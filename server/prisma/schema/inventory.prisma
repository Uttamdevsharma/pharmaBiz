model Inventory {
  id                String          @id @default(uuid())
  branchId          String
  productId         String
  supplierId        String?
  quantity          Int             @default(0) // Total quantity in lowest sellable unit (e.g. tablets, ml, units)
  initialQuantity   Int             @default(0)
  batchNumber       String?
  barcode           String?
  mfgDate           DateTime?
  expiryDate        DateTime?
  packageType       String?         @default("PIECE")
  boxQuantity       Int?
  stripsPerBox      Int?
  tabletsPerStrip   Int?
  purchasePrice     Decimal?        @db.Decimal(10, 2)
  sellingPrice      Decimal?        @db.Decimal(10, 2)
  shelfLocation     String?
  minStockLevel     Int             @default(10)
  lowStockThreshold Int             @default(5)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  branch            Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier          Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stockMovements    StockMovement[]

  @@index([branchId])
  @@index([productId])
  @@index([supplierId])
  @@index([batchNumber])
  @@index([barcode])
  @@index([expiryDate])
  @@index([quantity])
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum SettlementStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model StockTransfer {
  id                 String           @id @default(uuid())
  fromBranchId       String
  toBranchId         String
  status             TransferStatus   @default(IN_TRANSIT)
  requestedBy        String           // User ID who created/dispatched
  approvedBy         String?          // User ID
  receivedBy         String?          // User ID who received
  
  // Legacy / total value
  totalValue         Decimal?         @default(0) @db.Decimal(12, 2)
  
  // Financial valuations based strictly on purchase/cost price
  sentTotalValue     Decimal          @default(0) @db.Decimal(12, 2)
  receivedTotalValue Decimal          @default(0) @db.Decimal(12, 2)
  damagedTotalValue  Decimal          @default(0) @db.Decimal(12, 2)
  missingTotalValue  Decimal          @default(0) @db.Decimal(12, 2)
  payableAmount      Decimal          @default(0) @db.Decimal(12, 2) // equals receivedTotalValue
  paidAmount         Decimal          @default(0) @db.Decimal(12, 2)
  remainingDue       Decimal          @default(0) @db.Decimal(12, 2)
  settlementStatus   SettlementStatus @default(UNPAID)

  notes              String?
  rejectionReason    String?
  transferDate       DateTime         @default(now())
  receivedDate       DateTime?
  settlementDate     DateTime?

  // Professional Courier Logistics & Dispatch Information
  courierName           String?          // e.g. Steadfast, Pathao, RedX, Sundarban, Internal Rider
  courierHub            String?          // Hub / Branch of courier service
  trackingId            String?          // Waybill / Consignment / Tracking ID
  deliveryPersonName    String?          // Rider / Delivery Person Name
  deliveryPersonContact String?          // Rider Phone / Contact Number
  dispatchDate          DateTime?        // Dispatch Date & Time
  deliveryNote          String?          // Special delivery or handling instructions

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  fromBranch         Branch           @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: Cascade)
  toBranch           Branch           @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: Cascade)
  items              TransferItem[]
  settlements        TransferSettlement[]

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@index([settlementStatus])
  @@index([transferDate])
}

model TransferItem {
  id               String        @id @default(uuid())
  transferId       String
  productId        String
  inventoryId      String?
  batchNumber      String?
  expiryDate       DateTime?
  
  packageType      String?       @default("PIECE") // e.g. BOX, STRIP, TABLET, BOTTLE, PIECE
  packageQuantity  Int?          // Count in package unit (e.g. 10 boxes)
  conversionFactor Int?          @default(1)       // e.g. 100 tablets per box
  
  // Legacy quantity field kept for compatibility
  quantity         Int?          @default(0)
  unitPrice        Decimal?      @db.Decimal(10, 2)
  totalAmount      Decimal?      @db.Decimal(10, 2)
  
  sentQuantity     Int           @default(0)       // Total sent in lowest units
  receivedQuantity Int           @default(0)       // Total successfully received in lowest units
  damagedQuantity  Int           @default(0)       // Total damaged in transit
  missingQuantity  Int           @default(0)       // Total missing in transit
  
  costPrice        Decimal       @default(0) @db.Decimal(10, 2) // Actual purchase/cost price per lowest unit
  sentValue        Decimal       @default(0) @db.Decimal(10, 2) // sentQuantity * costPrice
  receivedValue    Decimal       @default(0) @db.Decimal(10, 2) // receivedQuantity * costPrice
  damagedValue     Decimal       @default(0) @db.Decimal(10, 2) // damagedQuantity * costPrice
  missingValue     Decimal       @default(0) @db.Decimal(10, 2) // missingQuantity * costPrice
  
  itemStatus       String        @default("PENDING") // PENDING, RECEIVED, PARTIALLY_RECEIVED, DAMAGED, MISSING
  notes            String?

  transfer         StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([productId])
  @@index([batchNumber])
}

model TransferSettlement {
  id                   String            @id @default(uuid())
  transferId           String
  tenantId             String
  fromBranchId         String            // Source branch (receiving funds)
  toBranchId           String            // Destination branch (paying funds)
  sourceAccountId      String?           // Paying account
  destinationAccountId String?           // Receiving account
  amount               Decimal           @db.Decimal(12, 2)
  paymentMethod        String            @default("CASH") // CASH, BANK, BKASH, NAGAD, etc.
  reference            String?
  notes                String?
  paidBy               String?           // User ID
  createdAt            DateTime          @default(now())

  transfer             StockTransfer     @relation(fields: [transferId], references: [id], onDelete: Cascade)
  fromBranch           Branch            @relation("SettlementFromBranch", fields: [fromBranchId], references: [id], onDelete: Cascade)
  toBranch             Branch            @relation("SettlementToBranch", fields: [toBranchId], references: [id], onDelete: Cascade)
  sourceAccount        FinancialAccount? @relation("SettlementSourceAccount", fields: [sourceAccountId], references: [id], onDelete: SetNull)
  destinationAccount   FinancialAccount? @relation("SettlementDestAccount", fields: [destinationAccountId], references: [id], onDelete: SetNull)

  @@index([transferId])
  @@index([tenantId])
  @@index([fromBranchId])
  @@index([toBranchId])
}

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  RETURN
}

model StockMovement {
  id                String       @id @default(uuid())
  branchId          String
  productId         String
  inventoryId       String?
  batchNumber       String?
  type              MovementType
  quantity          Int          // Positive for additions, negative for reductions
  remainingQuantity Int?
  unitPrice         Decimal?     @db.Decimal(10, 2)
  reason            String?
  performedBy       String?      // User ID
  referenceId       String?      // Sale ID, Purchase ID, Transfer ID, etc.
  createdAt         DateTime     @default(now())

  inventory         Inventory?   @relation(fields: [inventoryId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([productId])
  @@index([inventoryId])
  @@index([type])
  @@index([createdAt])
}
