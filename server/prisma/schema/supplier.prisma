enum PurchasePaymentStatus {
  PAID
  PARTIAL
  DUE
}

model Supplier {
  id             String     @id @default(uuid())
  tenantId       String
  name           String
  phone          String
  email          String?
  address        String?
  company        String?
  contactPerson  String?
  totalPurchased Decimal    @default(0) @db.Decimal(12, 2)
  totalPaid      Decimal    @default(0) @db.Decimal(12, 2)
  totalDue       Decimal    @default(0) @db.Decimal(12, 2)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases      Purchase[]
  inventories    Inventory[]
  receivingRecords BatchReceivingRecord[]
  contacts       SupplierContact[]
  payments       SupplierPayment[]

  @@index([tenantId])
  @@index([name])
  @@index([phone])
}

model Purchase {
  id                String                @id @default(uuid())
  tenantId          String
  branchId          String
  supplierId        String?
  contactPersonId   String?
  contactPersonName String?
  invoiceNo         String?
  purchaseDate      DateTime              @default(now())
  totalAmount       Decimal               @db.Decimal(12, 2)
  paidAmount        Decimal               @default(0) @db.Decimal(12, 2)
  dueAmount         Decimal               @default(0) @db.Decimal(12, 2)
  paymentStatus     PurchasePaymentStatus @default(PAID)
  paymentMethod     String?               @default("CASH")
  notes             String?
  receivedBy        String                // User ID
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier          Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  contactPerson     SupplierContact?      @relation(fields: [contactPersonId], references: [id], onDelete: SetNull)
  items             PurchaseItem[]
  payments          SupplierPayment[]

  @@index([tenantId])
  @@index([branchId])
  @@index([supplierId])
  @@index([contactPersonId])
  @@index([purchaseDate])
}

model PurchaseItem {
  id                String    @id @default(uuid())
  purchaseId        String
  productId         String
  inventoryId       String?
  batchNumber       String?
  barcode           String?
  mfgDate           DateTime?
  expiryDate        DateTime?
  packageType       String?   // "MEDICINE", "SYRUP", "EQUIPMENT", "SALINE"
  cartonQuantity    Int?
  boxQuantity       Int?
  stripsPerBox      Int?
  tabletsPerStrip   Int?
  quantity          Int       // Lowest sellable unit count
  unitPurchasePrice Decimal   @db.Decimal(10, 2)
  unitSellingPrice  Decimal   @db.Decimal(10, 2)
  totalAmount       Decimal   @db.Decimal(12, 2)
  shelfLocation     String?
  createdAt         DateTime  @default(now())

  purchase          Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([productId])
}

model SupplierContact {
  id          String    @id @default(uuid())
  tenantId    String
  supplierId  String
  name        String
  phone       String
  email       String?
  designation String?   // e.g. "Sales Representative (SR)", "Area Manager", "Delivery Executive"
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchases   Purchase[]
  receivingRecords BatchReceivingRecord[]

  @@index([tenantId])
  @@index([supplierId])
  @@index([phone])
}

model SupplierPayment {
  id                 String            @id @default(uuid())
  tenantId           String
  supplierId         String
  branchId           String?
  purchaseId         String?
  financialAccountId String?
  amount             Decimal           @db.Decimal(12, 2)
  previousDue        Decimal           @default(0) @db.Decimal(12, 2)
  remainingDue       Decimal           @default(0) @db.Decimal(12, 2)
  paymentMethod      String?           @default("CASH")
  reference          String?
  notes              String?
  paidBy             String?           // User ID
  paymentDate        DateTime          @default(now())
  createdAt          DateTime          @default(now())

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier           Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  branch             Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  purchase           Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([supplierId])
  @@index([branchId])
  @@index([paymentDate])
}
